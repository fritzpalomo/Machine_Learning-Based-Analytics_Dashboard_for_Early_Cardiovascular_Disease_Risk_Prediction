# Copy this file to .streamlit/secrets.toml for LOCAL use (that folder is
# already in .gitignore-style practice — never commit real secrets.toml).
#
# On Streamlit Community Cloud, don't upload this file at all — instead,
# paste these two lines into your app's "Settings -> Secrets" box in the
# Streamlit Cloud dashboard.

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "choose-a-real-password-here"
